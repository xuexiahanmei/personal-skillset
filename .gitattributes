# Text files are LF everywhere, regardless of core.autocrlf. Skill files are read by
# cross-platform tooling - skill-creator's validator matches the frontmatter with
# '^---
' and rejects a CRLF SKILL.md.
* text=auto eol=lf

# Windows-only scripts are the exception and keep CRLF.
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

# Line endings are all this file controls - not encoding. .ps1 files read by
# Windows PowerShell 5.1 must be pure ASCII or UTF-8 *with* BOM.

*.png binary
*.jpg binary
*.skill binary
